# Environment Variables for Vercel
# Copy this to .env.local for local development

# Database (Neon PostgreSQL على الإنتاج — Vercel env var)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ========================================
# Telegram Bot (موجود مسبقاً — لا تغيّر)
# ========================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_IDS=1429407129
JOIN_PASSWORD=MOOD2026

# ========================================
# WhatsApp Cloud API (جديد — مود شات WhatsApp)
# ========================================
# System User Token من Meta Business (صلاحيات: whatsapp_business_messaging, whatsapp_business_management, manage_app_solution)
WA_ACCESS_TOKEN=
# Phone Number ID من إعدادات WhatsApp API Setup
WA_PHONE_NUMBER_ID=1180359958489968
# Verify Token (أي قيمة تختارها — تُستخدم عند إعداد الـ Webhook في Meta)
WA_VERIFY_TOKEN=MOOD_BOT_2026_WA
# إصدار Graph API
WA_API_VERSION=v21.0
# رقم/أرقام مسؤول واتساب (صيغة E.164 بدون +، مفصولة بفواصل)
WA_ADMIN_PHONES=
# معرّفات إضافية (اختيارية — للوحة الإدارية)
WABA_ID=995700279847597
BUSINESS_ID=264033988099879
APP_ID=1337248955274773

