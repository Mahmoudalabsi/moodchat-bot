{
  "functions": {
    "src/app/api/telegram/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/whatsapp/webhook/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/whatsapp/send/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/whatsapp/test/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/process-tg-messages/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/process-wa-messages/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/process-tg-messages",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/process-wa-messages",
      "schedule": "0 * * * *"
    }
  ],
  "buildCommand": "npx prisma generate && npx prisma db push --accept-data-loss 2>/dev/null; next build",
  "installCommand": "bun install",
  "framework": "nextjs"
}
