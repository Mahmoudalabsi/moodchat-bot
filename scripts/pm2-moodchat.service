[Unit]
Description=PM2 process manager for moodchat-worker
After=network.target

[Service]
Type=forking
User=z
Environment=PATH=/home/z/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Environment=PM2_HOME=/home/z/.pm2
LimitNOFILE=65536
ExecStart=/home/z/.npm-global/lib/node_modules/pm2/bin/pm2 resurrect
ExecReload=/home/z/.npm-global/lib/node_modules/pm2/bin/pm2 reload all
ExecStop=/home/z/.npm-global/lib/node_modules/pm2/bin/pm2 kill
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
